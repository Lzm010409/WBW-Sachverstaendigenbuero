# Kopie als .env anlegen. NIEMALS ausgefuellt ins Repo committen.
#
# Jeder Wert hier kann genauso gut als Umgebungsvariable gesetzt werden (Cloud-
# Umgebung, settings.json, Shell) - gesetzte Variablen gewinnen immer, leere
# zaehlen als nicht gesetzt. Fuer eine Cloud-Sitzung ohne Umgebungsvariablen:
#   ./bauen.sh --mit-zugangsdaten   (baut diese Datei ins Plugin ein)

# --- L1: eigener Kleinanzeigen-Dienst (Coolify) ---
# KA_API_BASE ist optional: der Standardwert https://ka-api.gollenstede.app ist
# im Adapter eingebaut. Nur setzen, um ihn zu ueberschreiben - etwa auf
# https://ka-api.116.202.21.243.sslip.io (Traefik routet das auf denselben Dienst),
# falls die Domain oder Cloudflare einmal ausfaellt.
KA_API_BASE=
KA_API_USER=
KA_API_PASS=

# --- L2: Bright Data Web Unlocker (derzeit deaktiviert, siehe providers.json) ---
BRIGHTDATA_TOKEN=
BRIGHTDATA_ZONE=mcp_unlocker

# --- L3: Apify (letzte Rueckfallebene) ---
APIFY_TOKEN=

# Kostensperre: L3 laeuft NUR, wenn dies auf 1 steht. `npm test` setzt es nicht
# (die Testskripte setzen die Variable nirgends, und ein eigener Test prueft das).
# Hier bewusst dauerhaft auf 1: der Betreiber hat entschieden, dass die L3-Kosten
# in Ordnung gehen. Wer das enger haben will, laesst den Wert leer und setzt ihn
# pro Lauf: WBW_ALLOW_PAID=1 node fetch-portal.js mobile.de ...
WBW_ALLOW_PAID=1

# Optional: Pause zwischen Portalabrufen in ms (Default 1800, Minimum sinnvoll 1500)
WBW_PAUSE_MS=

# Optional: Pfad zu Chrome/Chromium fuer die PDF-Erzeugung, falls nicht im Standardpfad
WBW_CHROME=
