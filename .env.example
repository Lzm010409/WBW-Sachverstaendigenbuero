# Kopie als .env anlegen. NIEMALS ausgefuellt ins Repo committen.

# --- L1: eigener Kleinanzeigen-Dienst (Coolify) ---
# Traefik routet zusaetzlich https://ka-api.116.202.21.243.sslip.io auf denselben
# Dienst - nuetzlich, falls die Domain oder Cloudflare einmal ausfaellt.
KA_API_BASE=https://ka-api.gollenstede.app
KA_API_USER=
KA_API_PASS=

# --- L2: Bright Data Web Unlocker (derzeit deaktiviert, siehe providers.json) ---
BRIGHTDATA_TOKEN=
BRIGHTDATA_ZONE=mcp_unlocker

# --- L3: Apify (letzte Rueckfallebene) ---
APIFY_TOKEN=

# Kostensperre: L3 laeuft NUR, wenn dies auf 1 steht. `npm test` setzt es nicht.
WBW_ALLOW_PAID=

# Optional: Pause zwischen Portalabrufen in ms (Default 1800, Minimum sinnvoll 1500)
WBW_PAUSE_MS=

# Optional: Pfad zu Chrome/Chromium fuer die PDF-Erzeugung, falls nicht im Standardpfad
WBW_CHROME=
